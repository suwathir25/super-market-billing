# ─────────────────────────────────────────────────────────────────────
# SuperMart — Environment Variables
#
# RENAME this file to  .env  and fill in your real values.
# This file is loaded automatically by run.py on every startup.
# It is ignored by git (.gitignore excludes .env).
# ─────────────────────────────────────────────────────────────────────

# ── Flask security ────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Gmail SMTP (for password reset emails) ────────────────────────────
#
# HOW TO GET A GMAIL APP PASSWORD:
#   1. Enable 2-Step Verification:  https://myaccount.google.com/security
#   2. Create App Password:         https://myaccount.google.com/apppasswords
#      Select "Mail" → "Other (Custom name)" → Generate
#   3. Copy the 16-character code (spaces are OK) and paste it below.
#
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourshop@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_SENDER_NAME=SuperMart

# ── Reset token expiry (minutes) ──────────────────────────────────────
RESET_TOKEN_EXPIRY_MINUTES=15
